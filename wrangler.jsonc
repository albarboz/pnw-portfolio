// Cloudflare deploy config: the site is static, so Cloudflare serves the built dist/ folder as-is
// (no Worker code, no Vite plugin). Caching rules live in public/_headers.
{
  "name": "pnw-portfolio",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
