# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Vite fingerprints everything in /assets, so those can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts keep their names; they rarely change.
/fonts/*
  Cache-Control: public, max-age=2592000

# Photos keep their names and get re-made by the tools, so cache them for a day and refresh in the background.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The trail-run video (~4 MB): same as the photos.
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# GPU benchmark data for src/core/quality.ts; changes only when the package is updated.
/benchmarks/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
